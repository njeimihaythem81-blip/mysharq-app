# FAKE VALUES. Copy this text into Streamlit Cloud > App > Settings > Secrets
# and replace every value. NEVER commit a real secrets.toml to GitHub.
GITHUB_TOKEN_DATA   = "github_pat_REPLACE_data_repo_only"
GITHUB_TOKEN_IMAGES = "github_pat_REPLACE_images_repo_only"
GITHUB_OWNER  = "your-github-username"
IMAGES_REPO   = "mysharq-images"
DATA_REPO     = "mysharq-data"
BRANCH        = "main"
# --- ALERTS: use at least ONE of these (all free). Recommended: NTFY (instant push, no account).
NTFY_TOPIC = "mysharq-REPLACE-with-20-random-letters-and-digits"
# Optional e-mail alerts (Gmail App Password, not your normal password):
# EMAIL_USER = "yourname@gmail.com"
# EMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
# EMAIL_TO = "yourname@gmail.com"
# Optional Telegram (only if it works for you):
# TELEGRAM_BOT_TOKEN = "123456789:REPLACE"
# TELEGRAM_CHAT_IDS  = "123456789"
SESSION_SECRET = "REPLACE-with-at-least-32-random-characters"
SETUP_CODE     = "REPLACE-with-a-random-code"
APP_URL        = "https://your-app-name.streamlit.app"
